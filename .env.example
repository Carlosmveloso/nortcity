# Copie para .env.development.local e use um projeto de desenvolvimento.
# Nunca use service role ou segredos em variáveis VITE_*.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mantenha false em QA. Configure true no ambiente de produção, se desejado.
VITE_ANALYTICS_ENABLED=false
